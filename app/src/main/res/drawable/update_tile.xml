<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#1F4D42"/>
            <corners android:radius="20dp"/>
            <stroke android:width="2dp" android:color="#75C9B5"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#16372F"
                android:endColor="#102A24"/>
            <corners android:radius="20dp"/>
            <stroke android:width="1dp" android:color="#356A5D"/>
        </shape>
    </item>
</selector>
